@using SecondBrain.Server.Chat
<div class="answer-text">@((MarkupString)ChatTextRenderer.Render(Text, TurnId, SourceNumbers))</div>
@code {
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public string? TurnId { get; set; }
    [Parameter] public IReadOnlyCollection<int>? SourceNumbers { get; set; }
}
