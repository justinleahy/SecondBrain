@using SecondBrain.Core.Auth
@using SecondBrain.Core.Chat
@inject IChatExecutionRepository Executions

<div class="manifest">
    <button @onclick="LoadAsync">@(manifest is null ? "Show data sent to the model" : "Refresh data manifest")</button>
    @if (manifest is not null)
    {
        <p>Chat binding: <strong>@manifest.Provider</strong> · Model: @manifest.Model</p>
        @if (manifest.ProviderCalls is { Count: > 0 })
        {
            <details><summary>Prepared provider requests · @manifest.ProviderCalls.Count</summary>
                <ul>@foreach (var call in manifest.ProviderCalls)
                { <li>@call.Provider · @call.Model · @call.DocumentIds.Length referenced documents @if (call.DocumentIds.Length > 0) { <span>(@string.Join(", ", call.DocumentIds))</span> }</li> }</ul>
            </details>
        }
        <p>Conversation history: @(manifest.HistoryIncluded ? manifest.HistoryCompacted ? "included, with earlier excerpts compacted" : "included" : "not included")<br />Tool results: @manifest.ToolResultBytes.ToString("N0") bytes · Accounted tokens: @manifest.ChargedTokens.ToString("N0")</p>
        <p>Referenced documents are recorded at each chat or query-embedding boundary. A request can still fail before delivery.</p>
        @if (manifest.Documents.Count == 0) { <p>No document content was included.</p> }
        else
        {
            <ul>@foreach (var document in manifest.Documents) { <li>@document.DocumentId @if (document.Revision is not null) { <span>· revision @document.Revision</span> } · @document.Origin</li> }</ul>
        }
    }
    @if (error is not null) { <p role="alert">@error</p> }
</div>

@code {
    [Parameter, EditorRequired] public string TurnId { get; set; } = "";
    [Parameter, EditorRequired] public AuthenticatedCredential Actor { get; set; } = default!;
    private ChatEgressManifest? manifest;
    private string? error;
    private async Task LoadAsync()
    {
        try { manifest = await Executions.ManifestAsync(TurnId, Actor); error = null; }
        catch (AuthorityChangedException) { manifest = null; error = "Your session changed. Sign in again."; }
        catch (ChatNotFoundException) { manifest = null; error = "This conversation is no longer available."; }
    }
}
