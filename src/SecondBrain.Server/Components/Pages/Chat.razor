@page "/chat"
@page "/approvals"
@using Microsoft.AspNetCore.Components.Authorization
@using SecondBrain.Core.Auth
@using SecondBrain.Core.Chat
@using SecondBrain.Core.Ingestion
@using SecondBrain.Server.Auth
@using SecondBrain.Server.Chat
@implements IAsyncDisposable
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation
@inject IAuthRepository Auth
@inject IChatRepository Repository
@inject IChatProposalRepository Approvals
@inject IChatExecutionRepository Executions
@inject ChatService Assistant

<PageTitle>Chat · SecondBrain</PageTitle>
@if (actor is null)
{
    <main class="sign-in"><h1>SecondBrain</h1><p>Sign in to chat with your knowledge.</p><a href="/login">Sign in</a></main>
}
else
{
    <div class="chat-shell">
        <div class="mobile-toolbar" @onkeydown="NavigationKeyDownAsync">
            <a class="brand" href="/">◈ <span>SecondBrain</span></a>
            <button class="mobile-menu" @ref="mobileMenu" aria-label="Conversations" aria-controls="chat-navigation" aria-expanded="@(navigationOpen ? "true" : "false")" @onclick="() => navigationOpen = !navigationOpen">☰ <span>Chats</span></button>
            <button class="mobile-new" aria-label="New conversation" title="New conversation" disabled="@deleting" @onclick="NewConversation">＋</button>
        </div>
        <aside id="chat-navigation" class="sidebar @(navigationOpen ? "is-open" : "")" @onkeydown="NavigationKeyDownAsync">
            <a class="brand" href="/">◈ <span>SecondBrain</span></a>
            <button class="new-chat new-conversation" disabled="@deleting" @onclick="NewConversation">＋ New conversation</button>
            <button class="new-chat" @onclick="ShowApprovalsAsync">Approvals @if (proposals.Count(item => item.Status is "pending" or "executing") is var count && count > 0) { <span>(@count)</span> }</button>
            <a class="new-chat" href="/library">Library and search</a>
            <a class="new-chat" href="/activity">Timeline</a>
            <a class="new-chat" href="/capture">Capture a note</a>
            <a class="new-chat" href="/manage/sources">Sources and jobs</a>
            <a class="new-chat" href="/manage/trash">Trash</a>
            <a class="new-chat" href="/settings">Settings</a>
            <h2>Conversations</h2>
            <nav aria-label="Conversations">
                @foreach (var conversation in conversations)
                {
                    <div class="conversation-row">
                    <button class="conversation @(conversation.Id == selected ? "selected" : "")" disabled="@deleting" @onclick="() => SelectAsync(conversation.Id)">
                        <span>@conversation.Title</span>
                        @if (conversation.ActiveTurnId is not null) { <small>In progress</small> }
                    </button>
                    <button class="delete-conversation" aria-label="Delete conversation: @conversation.Title" title="Delete conversation" disabled="@(deleting || conversation.ActiveTurnId is not null)" @onclick="() => confirmingDelete = conversation.Id">×</button>
                    @if (confirmingDelete == conversation.Id)
                    {
                        <div class="delete-confirm" role="alert">
                            <p>Delete this conversation and its pending proposals? Saved notes will remain. This cannot be undone.</p>
                            <button disabled="@deleting" @onclick="() => DeleteConversationAsync(conversation.Id)">@(deleting ? "Deleting…" : "Delete")</button>
                            <button disabled="@deleting" @onclick="() => confirmingDelete = null">Cancel</button>
                        </div>
                    }
                    </div>
                }
            </nav>
            <p class="sidebar-note">Your knowledge, with sources.<br />Changes require your approval.</p>
        </aside>
        <main class="workspace">
            <header class="workspace-header"><div><span class="eyebrow">YOUR KNOWLEDGE ASSISTANT</span><h1>@(showAllApprovals ? "Approvals" : "Chat")</h1></div><a href="/">SecondBrain</a></header>
            <section class="messages" data-chat-scroll="@(showAllApprovals ? null : "conversation")" data-conversation-id="@selected" aria-label="Conversation" aria-live="polite" aria-busy="@(active ? "true" : "false")">
                @if (showAllApprovals)
                {
                    <h2>Review proposed changes</h2>
                    <p class="notice">Changes suggested by chat or connected clients wait here for your approval.</p>
                    @foreach (var proposal in proposals.Where(item => item.Status is "pending" or "executing"))
                    { <ApprovalCard @key="proposal.Id" Proposal="proposal" Actor="actor" Changed="ReloadProposalsAsync" /> }
                    @if (!proposals.Any(item => item.Status is "pending" or "executing")) { <p>No changes are waiting for approval.</p> }
                }
                else if (turns.Count == 0)
                {
                    <div class="welcome"><span class="welcome-icon">◈</span><h2>What would you like to find out?</h2><p>Ask a question about your notes and documents. Answers link back to the passages they use.</p><button @onclick="UseExample">What is the project codename? <span>↗</span></button></div>
                }
                @foreach (var turn in showAllApprovals ? Array.Empty<ChatTurn>() : turns)
                {
                    var displayedAnswer = turn.Answer is null ? null : ChatAnswerPresentation.ForDisplay(turn.Answer);
                    <article class="turn" data-chat-turn="@turn.Id" @key="turn.Id">
                        <div class="user-message"><span class="message-label">YOU</span><p>@turn.Prompt</p></div>
                        <div class="assistant-message"><span class="message-label">SECOND BRAIN <small>@turn.Policy.Model</small></span>
                            @if (turn.Redacted) { <p class="notice">This answer was removed because a source was purged.</p> }
                            else if (displayedAnswer is not null) { <ChatText Text="@displayedAnswer.Text" TurnId="@turn.Id" SourceNumbers="@displayedAnswer.Citations.Select(citation => citation.Source.Number).ToArray()" /> }
                            else if (drafts.TryGetValue(turn.Id, out var draft) && draft.Length > 0) { <ChatText Text="@draft" /> }
                            else if (turn.Status == "running") { <p class="thinking"><span></span> Searching your knowledge…</p> }
                            @if (turn.Status == "running") { <small class="notice">Generating · citations will be checked when the answer is complete</small> }
                            @if (turn.FailureCode is not null) { <p class="notice">This turn stopped: @FriendlyReason(turn.FailureCode). You can retry it or send another message.</p> }
                            @if (turn.Status is "partial" or "failed" && turn.Id == turns.LastOrDefault()?.Id)
                            { <button class="activity-link" disabled="@(active || sending || deleting)" @onclick="() => RetryAsync(turn.Id)">Retry this turn</button> }
                            @if (turn.Answer?.Warnings?.Contains("no_verified_sources") == true) { <p class="notice">This response has no verified sources.</p> }
                            @foreach (var warning in turn.Answer?.Warnings?.Where(value => value != "no_verified_sources") ?? [])
                            { <p class="notice">@WarningText(warning)</p> }
                            @if (displayedAnswer?.Citations.Count > 0)
                            {
                                <div class="sources"><h3>Sources</h3>
                                    @foreach (var citation in displayedAnswer.Citations)
                                    {
                                        <details id="@ChatTextRenderer.CitationTargetId(turn.Id, citation.Source.Number)" data-citation-source><summary><span class="source-number">[@citation.Source.Number]</span> @citation.Source.Title <small>revision @citation.Source.Revision · @citation.State</small></summary>
                                            @if(citation.Spans is {Count:>0} exact)
                                            {
                                                <small>Exact quoted text</small>
                                                @foreach(var span in exact) { <blockquote>@span.Excerpt</blockquote> }
                                            }
                                            else { <blockquote>@citation.Source.Excerpt</blockquote> }
                                            <small>Document @citation.Source.DocumentId · passage @(citation.Source.Ordinal + 1) @if (citation.Source.Page is not null) { <span>· page @citation.Source.Page</span> }</small>
                                            @if (citation.Source.Transcript is { } locator)
                                            {
                                                <p><a href="@("/library/" + Uri.EscapeDataString(citation.Source.DocumentId) + "?chunk=" + Uri.EscapeDataString(citation.Source.ChunkId) + "&revision=" + citation.Source.Revision + "#segment-" + locator.From)">@(locator.Speaker ?? "Unknown speaker") · @TranscriptTextProcessor.Timestamp(locator.StartMs)–@TranscriptTextProcessor.Timestamp(locator.EndMs)</a></p>
                                            }
                                            <SourceNote @key="citation.Source.DocumentId" DocumentId="@citation.Source.DocumentId" CitedRevision="@citation.Source.Revision" Actor="actor" />
                                        </details>
                                    }
                                </div>
                            }
                            @if (activity.TryGetValue(turn.Id, out var entries) && entries.Count > 0)
                            {
                                <details class="activity"><summary>Activity · @entries.Count actions</summary><ul>@foreach (var entry in entries) { <li>@entry</li> }</ul></details>
                            }
                            else if (turn.Status != "running")
                            { <button class="activity-link" @onclick="() => LoadActivityAsync(turn.Id)">View tool activity</button> }
                            @foreach (var proposal in proposals.Where(item => item.TurnId == turn.Id))
                            { <ApprovalCard @key="proposal.Id" Proposal="proposal" Actor="actor" Changed="ReloadProposalsAsync" /> }
                            <EgressManifest TurnId="@turn.Id" Actor="actor" />
                        </div>
                    </article>
                }
            </section>
            <div class="composer-area">
                @if (error is not null) { <p class="error" role="alert">@error</p> }
                <form class="composer" @onsubmit="SendAsync" @onsubmit:preventDefault>
                    <label class="sr-only" for="message">Message SecondBrain</label>
                    <textarea id="message" data-chat-input aria-describedby="message-help" @bind="prompt" @bind:event="oninput" placeholder="Ask about your knowledge…" rows="3" maxlength="32768" disabled="@(sending || deleting)"></textarea>
                    <div class="composer-actions"><label><input type="checkbox" @bind="askOnly" disabled="@(active || sending || deleting)" /> Read-only ask</label><button type="submit" disabled="@(active || sending || deleting || string.IsNullOrWhiteSpace(prompt))">@(active ? "Working…" : sending ? "Sending…" : "Send ↑")</button></div>
                </form>
                <p id="message-help" class="privacy-note">Enter to send · Shift+Enter for a new line</p>
                <p class="privacy-note">Your message, recent conversation, and retrieved passages are sent to your configured model. Check sources before relying on an answer.</p>
            </div>
        </main>
    </div>
}

@code {
    private AuthenticatedCredential? actor;
    private IReadOnlyList<ChatConversation> conversations = [];
    private IReadOnlyList<ChatTurn> turns = [];
    private IReadOnlyList<ChatProposal> proposals = [];
    private readonly Dictionary<string, string> drafts = [];
    private readonly Dictionary<string, List<string>> activity = [];
    private readonly CancellationTokenSource lifetime = new();
    private CancellationTokenSource? observation;
    private Task? observing;
    private string? selected, error, confirmingDelete;
    private string prompt = "";
    private bool sending, askOnly, showAllApprovals, deleting, navigationOpen;
    private ElementReference mobileMenu;
    private bool active => turns.Any(turn => turn.Status == "running");
    private void UseExample() => prompt = "What is the project codename?";

    protected override async Task OnInitializedAsync()
    {
        showAllApprovals = new Uri(Navigation.Uri).AbsolutePath == "/approvals";
        var principal = (await Authentication.GetAuthenticationStateAsync()).User;
        if (!SessionRevalidationProvider.TryAuthority(principal, out var id, out var generation, out var epoch)) return;
        var credential = await Auth.FindAsync(id!, lifetime.Token);
        if (credential is null) return;
        actor = new(id!, "session", generation, epoch, credential.GrantedScopes, credential.SteppedUpAt);
        try { conversations = await Repository.ListAsync(actor, lifetime.Token); await ReloadProposalsAsync(); }
        catch (AuthorityChangedException) { actor = null; }
    }

    private async Task CloseNavigationAsync()
    {
        if (!navigationOpen) return;
        navigationOpen = false;
        await mobileMenu.FocusAsync(preventScroll: true);
    }

    private async Task NavigationKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") await CloseNavigationAsync();
    }

    private async Task NewConversation()
    {
        await CloseNavigationAsync();
        observation?.Cancel(); selected = null; turns = []; error = null; confirmingDelete = null; showAllApprovals = false; askOnly = false;
    }

    private async Task SelectAsync(string id)
    {
        await CloseNavigationAsync();
        observation?.Cancel(); selected = id; error = null; confirmingDelete = null; showAllApprovals = false;
        try
        {
            turns = await Repository.GetConversationAsync(id, actor!, lifetime.Token);
            askOnly = turns.LastOrDefault()?.Mode == "ask";
            await ReloadProposalsAsync();
            if (turns.LastOrDefault()?.Status == "running") Observe(turns[^1].Id);
        }
        catch (Exception exception) when (exception is AuthorityChangedException or ChatNotFoundException) { error = "This conversation is no longer available. Sign in again if your session expired."; }
    }

    private async Task SendAsync()
    {
        if (active || sending || deleting || actor is null || string.IsNullOrWhiteSpace(prompt)) return;
        sending = true; error = null;
        try
        {
            if (prompt.Trim() == "/new") { prompt = ""; await NewConversation(); return; }
            var result = await Assistant.StartAsync(new(prompt, selected, askOnly ? "ask" : "chat", Guid.NewGuid().ToString("N")), actor, lifetime.Token);
            selected = result.Turn.ConversationId; prompt = "";
            showAllApprovals = false;
            turns = await Repository.GetConversationAsync(selected, actor, lifetime.Token);
            conversations = await Repository.ListAsync(actor, lifetime.Token);
            Observe(result.Turn.Id);
        }
        catch (Exception exception) when (exception is AuthorityChangedException or ChatConflictException or ChatLimitException or ChatNotFoundException or ArgumentException)
        {
            error = exception is AuthorityChangedException ? "Your session changed. Sign in again." : exception.Message;
        }
        finally { sending = false; }
    }

    private async Task DeleteConversationAsync(string id)
    {
        if (deleting || sending || actor is null) return;
        deleting = true; error = null;
        try
        {
            await Repository.DeleteConversationAsync(id, actor, lifetime.Token);
            if (selected == id)
            {
                foreach (var turn in turns) { drafts.Remove(turn.Id); activity.Remove(turn.Id); }
                await NewConversation();
            }
            confirmingDelete = null;
            conversations = await Repository.ListAsync(actor, lifetime.Token);
            await ReloadProposalsAsync();
        }
        catch (Exception exception) when (exception is AuthorityChangedException or ChatNotFoundException or ChatConflictException)
        { error = exception is AuthorityChangedException ? "Your session changed. Sign in again." : exception.Message; }
        finally { deleting = false; }
    }

    private async Task RetryAsync(string id)
    {
        if (actor is null || active || sending || deleting) return;
        sending = true; error = null;
        try
        {
            var result = await Assistant.RetryAsync(id, new(Guid.NewGuid().ToString("N")), actor, lifetime.Token);
            turns = await Repository.GetConversationAsync(result.Turn.ConversationId, actor, lifetime.Token);
            Observe(result.Turn.Id, result.ReplayAfter);
        }
        catch (Exception exception) when (exception is AuthorityChangedException or ChatConflictException or ChatLimitException or ChatNotFoundException)
        { error = exception is AuthorityChangedException ? "The original session is no longer valid. Send a new message instead." : exception.Message; }
        finally { sending = false; }
    }

    private void Observe(string turnId, long after = 0)
    {
        observation?.Cancel();
        observation = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
        drafts[turnId] = ""; activity[turnId] = [];
        observing = ObserveAsync(turnId, selected!, observation.Token, after);
    }

    private async Task ObserveAsync(string turnId, string conversationId, CancellationToken token, long after = 0)
    {
        long sequence = after;
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(500));
            do
            {
                var events = await Repository.EventsAsync(turnId, sequence, actor!, token);
                token.ThrowIfCancellationRequested();
                if (events.Any(item => item.Kind == "proposal")) await ReloadProposalsAsync();
                foreach (var item in events)
                {
                    sequence = item.Sequence;
                    if (item.Redacted) { drafts[turnId] = ""; activity[turnId].Clear(); continue; }
                    if (item.Kind == "delta" && item.Data is { } delta) drafts[turnId] += delta.GetProperty("text").GetString();
                    if (item.Kind == "resumed") drafts[turnId] = "";
                    if (item.Kind == "tool" && item.Data is { } tool) activity[turnId].Add(tool.GetProperty("name").GetString() ?? "Tool");
                    if (item.Kind == "finished")
                    {
                        if ((await Repository.GetTurnAsync(turnId, actor!, token)).Status == "running") continue;
                        if (selected == conversationId) turns = await Repository.GetConversationAsync(conversationId, actor!, token);
                        conversations = await Repository.ListAsync(actor!, token);
                        await ReloadProposalsAsync();
                        await InvokeAsync(StateHasChanged); return;
                    }
                }
                if (selected != conversationId) return;
                await InvokeAsync(StateHasChanged);
            } while (await timer.WaitForNextTickAsync(token));
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (AuthorityChangedException) { error = "Your session expired or was revoked. Sign in again."; await InvokeAsync(StateHasChanged); }
        catch (ChatNotFoundException) { error = "This conversation was deleted."; await InvokeAsync(StateHasChanged); }
        catch (Exception) { error = "The connection was interrupted. Reopen this conversation to reconnect."; await InvokeAsync(StateHasChanged); }
    }

    private static string FriendlyReason(string code) => code.Replace('_', ' ');
    private static string WarningText(string code) => code switch
    {
        "keyword_fallback" => "Semantic retrieval was unavailable; keyword results were used.",
        "history_compacted" => "Earlier conversation was condensed into excerpts; some details may be omitted.",
        "invalid_citations_removed" => "Unsupported source references were removed from this answer.",
        "metadata_truncated" => "Only part of the matching records was examined.",
        "calendar_subscription_stale" => "Some shared calendars are paused, out of date, or have not refreshed successfully. Their events may be incomplete or outdated.",
        _ => "Retrieval notice: " + code.Replace('_', ' ').Replace('-', ' ')
    };
    private async Task ReloadProposalsAsync() => proposals = await Approvals.ListAsync(null, actor!, lifetime.Token);
    private async Task LoadActivityAsync(string turnId)
    {
        try { activity[turnId] = (await Executions.ActivityAsync(turnId, actor!, lifetime.Token)).Select(item => item.Name + " · " + item.Status.Replace('_', ' ')).ToList(); }
        catch (AuthorityChangedException) { error = "Your session changed. Sign in again."; }
    }
    private async Task ShowApprovalsAsync() { await CloseNavigationAsync(); await ReloadProposalsAsync(); showAllApprovals = true; }
    public async ValueTask DisposeAsync()
    {
        await lifetime.CancelAsync(); observation?.Cancel();
        if (observing is not null) await observing;
        observation?.Dispose(); lifetime.Dispose();
    }
}
