<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>brain</AssemblyName>
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../SecondBrain.Core/SecondBrain.Core.csproj" />
    <ProjectReference Include="../SecondBrain.Infrastructure/SecondBrain.Infrastructure.csproj" />
    <ProjectReference Include="../SecondBrain.Storage/SecondBrain.Storage.csproj" />
    <!-- Layout only: copies the runnable daemon (apphost, dll, deps, runtimeconfig) beside brain so
         `brain serve` finds it under systemd and in the CI artifact. Never write `extern alias ServerLayout`. -->
    <ProjectReference Include="../SecondBrain.Server/SecondBrain.Server.csproj" Aliases="ServerLayout" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <!-- A plain SDK project copies the referenced server binaries, but not its Web SDK
       publish assets. Publish the server into the same bundle so brain serve has
       the exact web assets and endpoints manifest produced for that server. -->
  <Target Name="PublishBundledServer" AfterTargets="Publish">
    <PropertyGroup>
      <BundledServerPublishDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</BundledServerPublishDir>
    </PropertyGroup>
    <MSBuild Projects="../SecondBrain.Server/SecondBrain.Server.csproj" Targets="Publish"
             Properties="PublishDir=$(BundledServerPublishDir);Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained)" />
  </Target>
</Project>
