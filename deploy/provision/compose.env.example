# Required: your WireGuard or Tailscale address. CI uses loopback explicitly.
SECONDBRAIN_PRIVATE_ADDRESS=100.64.0.2
SECONDBRAIN_HOST_ROOT=/srv/secondbrain-compose
SECONDBRAIN_PORT=7171
# Resolver accessible from the Docker namespace; no unrestricted Docker DNS.
SECONDBRAIN_DNS_IP=10.8.0.1
# Space-separated numeric IP:port pairs. Add only endpoints selected in config.
SECONDBRAIN_PROVIDER_ALLOWLIST=10.8.0.5:8000
# Access JWKS is separately pinned. This placeholder fails closed until edited.
SECONDBRAIN_ACCESS_ALLOWLIST=192.0.2.1:443
# Hosted endpoints are ignored unless local_only is explicitly false.
SECONDBRAIN_LOCAL_ONLY=true
SECONDBRAIN_HOSTED_ALLOWLIST=
# Public tunnel is opt-in: --profile tunnel. Credentials file is mounted 0600.
SECONDBRAIN_TUNNEL_CREDENTIALS=/etc/secondbrain/secrets/cloudflared.json
