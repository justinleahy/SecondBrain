[Unit]
Description=SecondBrain private knowledge daemon
After=network-online.target secondbrain-extractor.socket
Wants=network-online.target
Requires=secondbrain-extractor.socket
ConditionPathExists=/etc/secondbrain/config.yaml

[Service]
Type=simple
User=secondbrain
Group=secondbrain
UMask=0077
WorkingDirectory=/srv/secondbrain
Environment=SECONDBRAIN_CONFIG=/etc/secondbrain/config.yaml
Environment=DOTNET_EnableDiagnostics=0
ExecStart=/usr/local/lib/secondbrain/brain serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/srv/secondbrain /srv/secondbrain-incoming/inbox /run/secondbrain -/etc/secondbrain/settings
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LimitCORE=0
# 1M vectors x 1024 float32 dimensions require about 3.8 GiB before other live state.
# Override MemoryMax in a service drop-in when sizing a different corpus.
MemoryMax=8G
TasksMax=256
IPAccounting=yes
IPAddressDeny=any
IPAddressAllow=localhost
# Provider-data allowance: replace with the exact pinned trusted service IPs.
IPAddressAllow=10.8.0.5
# Control plane: resolver, then Access certificate endpoint. The documentation
# address deliberately grants no public service until an operator pins its IPs.
IPAddressAllow=10.8.0.1
IPAddressAllow=192.0.2.1
# Optional source-only public calendar pins belong in 40-calendar-egress.conf.
# Generate that drop-in with brain maintenance calendar-egress; default is none.

[Install]
WantedBy=multi-user.target
